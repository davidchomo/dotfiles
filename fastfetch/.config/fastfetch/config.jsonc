// Logo: ASCII text from logo.txt in the rice's rust/orange palette.
// Change the text: edit logo.txt ($1/$2 = colors below).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;194;87;26", "2": "38;2;232;140;80" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;232;140;80", "title": "38;2;194;87;26" }
  },
  "modules": [
    "title", "separator", "os", "kernel", "uptime", "packages", "shell",
    "wm", "terminal", "cpu", "gpu", "memory", "disk", "battery", "break", "colors"
  ]
}
