[Unit]
Description=CPU temperature cap 85 °C in Balanced/Quiet (ryzenadj)
After=power-profiles-daemon.service graphical.target
# Emergency switch: add "noryzenadj" to the kernel command line (Limine: press E) to skip it.
ConditionKernelCommandLine=!noryzenadj

[Service]
Type=oneshot
ExecStartPre=-/usr/bin/modprobe ryzen_smu
ExecStart=/usr/local/bin/ryzenadj-tune
