# Hyprland-only env (UWSM). Hybrid AMD+NVIDIA laptops only (install.sh creates the gpu-amd link):
# Hyprland on the AMD iGPU only + Mesa-only EGL so the NVIDIA dGPU can sleep.
# USB-C/DP outputs wired to the NVIDIA GPU won't work in Hyprland then.
if [ -e "$HOME/.config/hypr/gpu-amd" ]; then
    export AQ_DRM_DEVICES="$HOME/.config/hypr/gpu-amd"
    export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
fi
