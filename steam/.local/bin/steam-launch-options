#!/bin/sh
# Give every installed Steam game "$HOME/.local/bin/nvidia-run gamemoderun mangohud %command%"
# (see ~/.local/share/steam-launch-options/steam_launch_options.py). Needs the venv with the
# "vdf" library that install.sh creates.
exec "$HOME/.local/share/steam-launch-options/venv/bin/python" -I \
    "$HOME/.local/share/steam-launch-options/steam_launch_options.py" "$@"
